        "jsCode": "const mensagem = $input.item.json.message?.text ?? '';\nconst chatId = $input.item.json.message?.chat?.id;\n\nlet comando = 'conversa';\n\nif (mensagem.startsWith('/criterios')) {\n  comando = 'criterios';\n} else if (mensagem.startsWith('/email')) {\n  comando = 'email';\n}\n\nreturn {\n  mensagem,\n  chatId,\n  comando\n};"
