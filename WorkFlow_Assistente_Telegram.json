    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const parts = $input.item.json.content?.parts;\nconst raw = parts?.[0]?.text ?? $input.item.json.text ?? '{}';\n\nlet resultado;\ntry {\n  const clean = raw.replace(/```json|```/g, '').trim();\n  resultado = JSON.parse(clean);\n} catch(e) {\n  resultado = { texto: raw, novoOffset: 0 };\n}\n\nconst chatId = $('Preparar Contexto IA').item.json.chatId;\nconst mensagem = $('Preparar Contexto IA').item.json.mensagem;\n\nreturn {\n  chatId,\n  texto: resultado.texto ?? 'Desculpe, não entendi.',\n  novoOffset: resultado.novoOffset ?? 0,\n  mensagemUsuario: mensagem\n};"
      },
