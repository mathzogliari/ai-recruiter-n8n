      "id": "595e118b-0460-48b6-be5d-84647485a8d5",
      "name": "Merge1"
    },
    {
      "parameters": {
        "jsCode": "const mensagem = $('Identificar Comando').item.json.mensagem.trim();\nconst mensagemLower = mensagem.toLowerCase();\nconst chatId = $('Identificar Comando').item.json.chatId;\n\nconst aprovados = (() => { try { return $('Buscar Candidatos Email').all().map(i => i.json).filter(i => i && i.email); } catch(e) { return []; } })();\nconst rejeitados = (() => { try { return $('Buscar Rejeitados Email').all().map(i => i.json).filter(i => i && i.email); } catch(e) { return []; } })();\n\nconst subcomando = mensagem.replace('/email', '').trim();\n\n// Se /email sem subcomando, mostra lista\nif (!subcomando) {\n  const todos = [\n    ...aprovados.map(c => ({...c, tipo: 'aprovado'})),\n    ...rejeitados.map(c => ({...c, tipo: 'rejeitado'}))\n  ].sort((a, b) => (b.score || 0) - (a.score || 0));\n\n  if (todos.length === 0) {\n    return [{ chatId, enviar: false, texto: '❌ Nenhum candidato cadastrado ainda.' }];\n  }\n\n  const listagem = todos.map((c, i) =>\n    `${i+1}. *${c.nome}* — Score: ${c.score || 0} — ${c.tipo === 'aprovado' ? '✅ Aprovado' : '❌ Rejeitado'}`\n  ).join('\\n');\n\n  const texto = `📋 *Candidatos encontrados:*\\n\\n${listagem}\\n\\nPara enviar email use:\\n• /email todos\\n• /email aprovados\\n• /email rejeitados\\n• /email nome do candidato`;\n\n  return [{ chatId, enviar: false, texto }];\n}\n\n// Com subcomando — filtra e envia\nlet candidatosParaEnviar = [];\n\nif (subcomando.toLowerCase() === 'todos') {\n  candidatosParaEnviar = [\n    ...aprovados.map(c => ({...c, tipo: 'aprovado'})),\n    ...rejeitados.map(c => ({...c, tipo: 'rejeitado'}))\n  ];\n} else if (subcomando.toLowerCase() === 'aprovados') {\n  candidatosParaEnviar = aprovados.map(c => ({...c, tipo: 'aprovado'}));\n} else if (subcomando.toLowerCase() === 'rejeitados') {\n  candidatosParaEnviar = rejeitados.map(c => ({...c, tipo: 'rejeitado'}));\n} else {\n  const todos = [\n    ...aprovados.map(c => ({...c, tipo: 'aprovado'})),\n    ...rejeitados.map(c => ({...c, tipo: 'rejeitado'}))\n  ];\n  candidatosParaEnviar = todos.filter(c =>\n    c.nome && c.nome.toLowerCase().includes(subcomando.toLowerCase())\n  );\n}\n\nif (candidatosParaEnviar.length === 0) {\n  return [{ \n    chatId, \n    enviar: false, \n    texto: `❌ Nenhum candidato encontrado para: \"${subcomando}\"\\n\\nUse:\\n/email todos\\n/email aprovados\\n/email rejeitados\\n/email nome do candidato`\n  }];\n}\n\nreturn candidatosParaEnviar.map(c => {\n  const aprovado = c.tipo === 'aprovado';\n  const assunto = aprovado\n    ? 'Parabéns! Você foi aprovado'\n    : 'Retorno sobre sua candidatura';\n  const corpo = aprovado\n    ? `Olá ${c.nome},\\n\\nFicamos felizes em informar que seu perfil foi aprovado em nossa análise inicial. Em breve entraremos em contato para os próximos passos do processo seletivo.\\n\\nAtenciosamente,\\nEquipe de Recrutamento`\n    : `Olá ${c.nome},\\n\\nAgradecemos seu interesse e o tempo dedicado ao processo. Após análise do seu perfil, informamos que não seguiremos com sua candidatura neste momento.\\n\\nDesejamos sucesso na sua jornada profissional.\\n\\nAtenciosamente,\\nEquipe de Recrutamento`;\n\n  return {\n    chatId,\n    enviar: true,\n    email: c.email,\n    nome: c.nome,\n    tipo: c.tipo,\n    assunto,\n    corpo\n  };\n});"
      },
