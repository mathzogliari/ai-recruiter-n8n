    {
      "parameters": {
        "jsCode": "const mensagem = $('Identificar Comando').item.json.mensagem;\nconst chatId = $('Identificar Comando').item.json.chatId;\n\nconst historico = (() => { try { return $('Buscar Historico').all().map(i => i.json).filter(i => i && Object.keys(i).length > 0); } catch(e) { return []; } })();\nconst candidatos = (() => { try { return $('Buscar Todos Candidatos').all().map(i => i.json).filter(i => i && Object.keys(i).length > 0); } catch(e) { return []; } })();\nconst rejeitados = (() => { try { return $('Buscar Todos Rejeitados').all().map(i => i.json).filter(i => i && Object.keys(i).length > 0); } catch(e) { return []; } })();\nconst sessao = (() => { try { return $('Buscar Sessao').all().map(i => i.json); } catch(e) { return []; } })();\nconst offset = parseInt(sessao.find(s => s.chave === 'offset_candidatos')?.valor ?? '0');\n\nconst historicoFormatado = historico\n  .sort((a, b) => new Date(a.timestamp) - new Date(b.timestamp))\n  .slice(-10)\n  .map(h => `${h.role}: ${h.mensagem}`).join('\\n');\n\nconst dadosCandidatos = JSON.stringify(candidatos.map(c => ({\n  nome: c.nome, email: c.email, score: c.score,\n  idade: c.idade, ingles: c.ingles, experiencia: c.experiencia,\n  skills: c.skills, aprovado: true, data_envio: c.data_envio\n})));\n\nconst dadosRejeitados = JSON.stringify(rejeitados.map(c => ({\n  nome: c.nome, email: c.email, score: c.score,\n  idade: c.idade, ingles: c.ingles, experiencia: c.experiencia,\n  skills: c.skills, motivo: c.motivo, aprovado: false, data_envio: c.data_envio\n})));\n\nconst prompt = `Você é um assistente de RH inteligente. Responda em português brasileiro.\n\nDADOS DISPONÍVEIS:\nCandidatos aprovados: ${dadosCandidatos}\nCandidatos rejeitados: ${dadosRejeitados}\nOffset atual de paginação: ${offset}\n\nREGRAS:\n1. Consultas de quantidade: responda direto ex: \"Candidatos rejeitados: 34\"\n2. Listagem de candidatos: mostre nome, score, motivo (se rejeitado), data_envio\n3. Ranking (menos/mais qualificados): mostre sempre em blocos de 3 ordenado por score, pergunte \"Deseja ver mais candidatos?\" ao final\n4. Filtros por data: interprete \"hoje\", \"essa semana\", \"esse mês\", \"esse ano\" ou datas específicas no formato DD-MM-AAAA e filtre pelo campo data_envio\n5. Quando o usuário pedir \"mais\" ou \"ver mais\": mostre os próximos 3 usando o offset atual\n6. Sempre diferencie aprovados de rejeitados quando o usuário especificar\n7. Para ranking dos menos qualificados: ordene do menor score para o maior\n8. Para ranking dos mais qualificados: ordene do maior score para o menor\n9. Retorne APENAS um JSON com os campos: texto (resposta para o usuário), novoOffset (número inteiro com o novo offset para paginação)\n\nHISTÓRICO DA CONVERSA:\n${historicoFormatado}\n\nMENSAGEM ATUAL DO USUÁRIO: ${mensagem}`;\n\nreturn [{ chatId, prompt, offset, mensagem }];"
      },
