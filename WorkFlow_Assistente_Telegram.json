    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const mensagem = $('Identificar Comando').item.json.mensagem;\nconst chatId = $('Identificar Comando').item.json.chatId;\nconst criterios = $input.item.json;\nconst isAlteracao = mensagem.replace('/criterios', '').trim().includes(':');\nif (!isAlteracao) {\n  const texto = `⚙️ Critérios atuais:\\n\\n• Idade mínima: ${criterios.idade_minima} anos\\n• Inglês mínimo: ${criterios.ingles_minimo}\\n• Experiência mínima: ${criterios.experiencia_minima} anos\\n• Skills obrigatórias: ${criterios.skills_obrigatorias}\\n\\nComo alterar:\\nEnvie /criterios seguido das alterações:\\n\\n/criterios idade: 25\\n/criterios ingles: avancado\\n/criterios experiencia: 5\\n/criterios skills: Python,React,Node.js`;\n  return { chatId, texto, acao: 'mostrar' };\n}\nconst parte = mensagem.replace('/criterios', '').trim();\nconst linhas = parte.split('\\n');\nconst alteracoes = {};\nfor (const linha of linhas) {\n  const idx = linha.indexOf(':');\n  if (idx !== -1) {\n    const chave = linha.substring(0, idx).trim().toLowerCase();\n    const valor = linha.substring(idx + 1).trim();\n    if (chave === 'idademinima' || chave === 'idade') alteracoes['idade_minima'] = parseInt(valor);\n    else if (chave === 'inglesminimo' || chave === 'ingles') alteracoes['ingles_minimo'] = valor;\n    else if (chave === 'experienciaminima' || chave === 'experiencia') alteracoes['experiencia_minima'] = parseInt(valor);\n    else if (chave === 'skills') alteracoes['skills_obrigatorias'] = valor;\n    else alteracoes[chave] = valor;\n  }\n}\nreturn {\n  chatId,\n  alteracoes,\n  criteriosAtuais: criterios,\n  acao: 'alterar'\n};"
      },
